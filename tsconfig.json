{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": false,
		"baseUrl": "/opt/homebrew/lib/node_modules",
		"ignoreDeprecations": "6.0",
		"types": ["node"],
		"typeRoots": [
			"/opt/homebrew/lib/node_modules/@mariozechner/pi-coding-agent/node_modules/@types"
		],
		"paths": {
			"@mariozechner/pi-ai": [
				"@mariozechner/pi-coding-agent/node_modules/@mariozechner/pi-ai"
			],
			"@mariozechner/pi-ai/*": [
				"@mariozechner/pi-coding-agent/node_modules/@mariozechner/pi-ai/*"
			],
			"@mariozechner/pi-tui": [
				"@mariozechner/pi-coding-agent/node_modules/@mariozechner/pi-tui"
			],
			"@mariozechner/pi-tui/*": [
				"@mariozechner/pi-coding-agent/node_modules/@mariozechner/pi-tui/*"
			],
			"typebox": [
				"@mariozechner/pi-coding-agent/node_modules/typebox"
			],
			"typebox/*": [
				"@mariozechner/pi-coding-agent/node_modules/typebox/*"
			]
		}
	},
	"include": ["./*.ts"]
}
